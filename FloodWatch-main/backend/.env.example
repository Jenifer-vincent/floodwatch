# ============================================================
# FloodWatch backend: LOCAL DEVELOPMENT example
#
# To override the defaults, copy this file to backend/.env.
# The backend also runs without any .env file (defaults below apply).
# Never commit a real .env file or any real secret.
# ============================================================

# SECRET. Signs login tokens. The development default is used when this is
# unset, and the backend logs a warning. Set a long random value for anything
# beyond local development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret

# ---- Optional. Defaults shown. ----

# "development" or "test" for local work. Use "production" only on a real server.
ENVIRONMENT=development

# true enables debug-level logging. Use false for production.
DEBUG=true

APP_NAME=FloodWatch API

# Token signing algorithm and lifetime (minutes). 1440 = 24 hours.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins allowed by CORS. The Vite dev server runs on
# port 3000, and 5173 is Vite's default port.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Storage folders. Relative paths are resolved from the backend/ folder.
DATA_DIR=data
UPLOAD_DIR=uploads

# Largest accepted report photo, in megabytes.
MAX_UPLOAD_SIZE_MB=4


# Optional: folder with the Chennai GIS GeoJSON files.
# Leave blank to use r-backend/outputs at the repository root.
# GIS_DATA_DIR=
